  {
    "name": "body-preview",
    "source": "<mjml lang=\"ar\" dir=\"rtl\"><mj-head><mj-title>Subject</mj-title><mj-preview>Preview</mj-preview></mj-head><mj-body id=\"email\" css-class=\"mail\" background-color=\"#eeeeee\"><mj-section ><mj-column><mj-text>Hello</mj-text></mj-column></mj-section></mj-body></mjml>",
    "options": {},
    "checks": [
      {
        "selector": "body",
        "attributes": [
          "id",
          "class"
        ],
        "styles": [
          "word-spacing",
          "background-color"
        ]
      },
      {
        "selector": "body > div[role=\"article\"]",
        "attributes": [
          "aria-label",
          "aria-roledescription",
          "role",
          "lang",
          "dir",
          "class"
        ],
        "styles": [
          "word-spacing",
          "background-color"
        ]
      },
      {
        "selector": "body > div:first-child",
        "text": true
      }
    ],
    "fragments": [],
    "expected": [
      [
        {
          "id": "email",
          "class": "mail",
          "style:word-spacing": "normal",
          "style:background-color": "#eeeeee"
        }
      ],
      [
        {
          "aria-label": "Subject",
          "aria-roledescription": "email",
          "role": "article",
          "lang": "ar",
          "dir": "rtl",
          "class": null,
          "style:word-spacing": "normal",
          "style:background-color": "#eeeeee"
        }
      ],
      [
        {
          "text": "Preview"
        }
      ]
    ]
  },
